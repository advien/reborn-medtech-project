# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# Testing / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data (protocol and pointers only — never the data itself)
data/*
!data/README.md
!data/.gitignore

# Experiment outputs: raw/bulky output is ignored; the small fingerprint-stamped result tables
# the public notebooks write (nb01_/nb02_/nb03_) are committed so every figure traces to a file.
experiments/results/*
!experiments/results/.gitkeep
!experiments/results/nb0*_*.csv
!experiments/results/nb0*_*.json

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Research/manuscript track — lives in a separate private repository, never committed here
/research-private/
/papers/
